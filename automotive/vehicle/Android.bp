prebuilt_etc {
    name: "vehicle-commonapi.ini",
    vendor: true,
    //sub_dir: "genivi-capi-someip-examples",
    src: "config/commonapi4someip.ini",
    filename: "commonapi.ini",
}

prebuilt_etc {
    name: "vehicle-vsomeip.json",
    vendor: true,
    //sub_dir: "genivi-capi-someip-examples",
    src: "config/vsomeip-local.json",
    filename: "vsomeip.json",
}

